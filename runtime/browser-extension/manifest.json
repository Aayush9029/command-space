{
  "manifest_version": 3,
  "name": "Command Space Browser Bridge",
  "description": "Connect browser tabs and page content to Command Space extensions on Linux.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Command Space",
    "default_popup": "popup.html"
  }
}
